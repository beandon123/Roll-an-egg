{
  "name": "RollAnEgg",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$className": "Folder",
        "Fusion": {
          "$path": "vendor/Fusion/src"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore/ProfileStore.luau"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}
